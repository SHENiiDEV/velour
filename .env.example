APP_NAME=VELOUR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=velour
# DB_USERNAME=velour_user
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Namecheap PrivateEmail SMTP Configuration:
MAIL_MAILER=smtp
MAIL_HOST=mail.privateemail.com
MAIL_PORT=465
MAIL_USERNAME=info@velour-retail.com
MAIL_PASSWORD=YOUR_PRIVATEEMAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@velour-retail.com"
MAIL_FROM_NAME="VELOUR"

# Velour Atelier Settings
VELOUR_STATEMENT_DESCRIPTOR="VLR RETAIL"
VELOUR_CURRENCY=EUR
VELOUR_SHIPPING_FLAT=590
VELOUR_SHIPPING_FREE_FROM=9000
VELOUR_PAYMENT_DRIVER=manual
VELOUR_EXIT_URL="https://www.google.com"

VITE_APP_NAME="${APP_NAME}"
